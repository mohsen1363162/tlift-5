# ═══════════════════════════════════════════════════════════════
# تنظیمات محیط توسعه — این فایل توسط Vite فقط در حالت `npm run dev` خوانده می‌شود
# ═══════════════════════════════════════════════════════════════

# ── همگام‌سازی ابری ──
# پیش‌فرض (بدون هیچ تنظیمی): همگام‌سازی از طریق فایل PHP روی هاست خود سایت
# انجام می‌شود (api/sync.php در خروجی سی‌پنل) و نیازی به سوپابیس نیست.
#
# فقط اگر بخواهید از سوپابیس استفاده کنید این دو را پر کنید:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (اختیاری) تغییر آدرس و توکن سرویس همگام‌سازی روی هاست:
# VITE_SYNC_API=/api/sync.php
# VITE_SYNC_TOKEN=tlift-asemansara-1405
